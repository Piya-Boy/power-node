["export type ServiceLifetime = \"singleton\" | \"transient\" | \"scoped\";","","export interface ServiceDescriptor<T = unknown> {","  token: string;","  lifetime: ServiceLifetime;","  factory: (container: Container) => T;","  tags: string[];","  description?: string;","}","","export interface ResolvedService<T = unknown> {","  token: string;","  value: T;","  lifetime: ServiceLifetime;","  resolvedAt: number;","}","","export interface Container {","  descriptors: Map<string, ServiceDescriptor>;","  singletons: Map<string, ResolvedService>;","  scopedInstances: Map<string, ResolvedService>;","  parent?: Container;","  scopeId?: string;","}","","export function createContainer(parent?: Container, scopeId?: string): Container {","  return {","    descriptors: new Map(),","    singletons: new Map(),","    scopedInstances: new Map(),","    parent,","    scopeId,","  };","}","","export function register<T>(","  container: Container,","  token: string,","  factory: (c: Container) => T,","  options: { lifetime?: ServiceLifetime; tags?: string[]; description?: string } = {}","): Container {","  const descriptor: ServiceDescriptor<T> = {","    token,","    lifetime: options.lifetime ?? \"transient\",","    factory: factory as (c: Container) => unknown,","    tags: options.tags ?? [],","    description: options.description,","  };","  const descriptors = new Map(container.descriptors);","  descriptors.set(token, descriptor);","  return { ...container, descriptors };","}","","export function registerValue<T>(","  container: Container,","  token: string,","  value: T,","  options: { tags?: string[]; description?: string } = {}","): Container {","  return register(container, token, () => value, { lifetime: \"singleton\", ...options });","}","","export function registerAlias(","  container: Container,","  alias: string,","  target: string","): Container {","  return register(container, alias, (c) => resolve(c, target), { lifetime: \"transient\" });","}","","export function hasService(container: Container, token: string): boolean {","  if (container.descriptors.has(token)) return true;","  if (container.parent) return hasService(container.parent, token);","  return false;","}","","export function resolve<T>(container: Container, token: string, now = Date.now()): T {","  const descriptor = container.descriptors.get(token) ?? container.parent?.descriptors.get(token);","  if (!descriptor) {","    throw new Error(`Service not registered: ${token}`);","  }","","  if (descriptor.lifetime === \"singleton\") {","    const existing = container.singletons.get(token) ?? container.parent?.singletons.get(token);","    if (existing) return existing.value as T;","    const value = descriptor.factory(container) as T;","    container.singletons.set(token, { token, value, lifetime: \"singleton\", resolvedAt: now });","    return value;","  }","","  if (descriptor.lifetime === \"scoped\") {","    const existing = container.scopedInstances.get(token);","    if (existing) return existing.value as T;","    const value = descriptor.factory(container) as T;","    container.scopedInstances.set(token, { token, value, lifetime: \"scoped\", resolvedAt: now });","    return value;","  }","","  // transient — new instance every time","  return descriptor.factory(container) as T;","}","","export function resolveAll<T>(container: Container, tag: string, now = Date.now()): T[] {","  const results: T[] = [];","  const tokens = new Set<string>();","  // Collect from parent first","  if (container.parent) {","    for (const [token, desc] of container.parent.descriptors) {","      if (desc.tags.includes(tag) && !tokens.has(token)) {","        tokens.add(token);","        results.push(resolve<T>(container, token, now));","      }","    }","  }","  for (const [token, desc] of container.descriptors) {","    if (desc.tags.includes(tag) && !tokens.has(token)) {","      tokens.add(token);","      results.push(resolve<T>(container, token, now));","    }","  }","  return results;","}","","export function createScope(parent: Container, scopeId: string): Container {","  return {","    descriptors: new Map(parent.descriptors),","    singletons: parent.singletons,","    scopedInstances: new Map(),","    parent,","    scopeId,","  };","}","","export function disposeScope(scope: Container): Container {","  return { ...scope, scopedInstances: new Map() };","}","","export function listRegistered(container: Container): string[] {","  const tokens = new Set<string>();","  if (container.parent) listRegistered(container.parent).forEach((t) => tokens.add(t));","  container.descriptors.forEach((_, t) => tokens.add(t));","  return Array.from(tokens);","}","","export function getDescriptor(container: Container, token: string): ServiceDescriptor | undefined {","  return container.descriptors.get(token) ?? container.parent?.descriptors.get(token);","}","","export function getServicesByTag(container: Container, tag: string): ServiceDescriptor[] {","  const seen = new Set<string>();","  const results: ServiceDescriptor[] = [];","  if (container.parent) {","    getServicesByTag(container.parent, tag).forEach((d) => {","      if (!seen.has(d.token)) { seen.add(d.token); results.push(d); }","    });","  }","  for (const desc of container.descriptors.values()) {","    if (desc.tags.includes(tag) && !seen.has(desc.token)) {","      seen.add(desc.token);","      results.push(desc);","    }","  }","  return results;","}","","export interface ContainerStats {","  registeredCount: number;","  singletonCount: number;","  scopedCount: number;","  byLifetime: Record<ServiceLifetime, number>;","  tags: string[];","}","","export function getContainerStats(container: Container): ContainerStats {","  const byLifetime: Record<ServiceLifetime, number> = { singleton: 0, transient: 0, scoped: 0 };","  const allTags = new Set<string>();","  for (const desc of container.descriptors.values()) {","    byLifetime[desc.lifetime]++;","    desc.tags.forEach((t) => allTags.add(t));","  }","  return {","    registeredCount: container.descriptors.size,","    singletonCount: container.singletons.size,","    scopedCount: container.scopedInstances.size,","    byLifetime,","    tags: Array.from(allTags),","  };","}"]
