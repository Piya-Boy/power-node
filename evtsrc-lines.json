["export type EventType = string;","","export interface DomainEvent {","  id: string;","  type: EventType;","  aggregateId: string;","  aggregateType: string;","  version: number;","  payload: Record<string, unknown>;","  metadata: Record<string, unknown>;","  timestamp: number;","  causedBy?: string;","}","","export interface EventStore {","  events: DomainEvent[];","  snapshots: Record<string, AggregateSnapshot>;","}","","export interface AggregateSnapshot {","  aggregateId: string;","  aggregateType: string;","  version: number;","  state: Record<string, unknown>;","  timestamp: number;","}","","export type Reducer<S> = (state: S, event: DomainEvent) => S;","","let _evtSeq = 0;","export function resetEvtSeq(): void { _evtSeq = 0; }","","export function createEvent(","  type: EventType,","  aggregateId: string,","  aggregateType: string,","  payload: Record<string, unknown>,","  options: { version?: number; metadata?: Record<string, unknown>; causedBy?: string } = {},","  now = Date.now()","): DomainEvent {","  return {","    id: \"evt_\" + (++_evtSeq),","    type,","    aggregateId,","    aggregateType,","    version: options.version ?? _evtSeq,","    payload,","    metadata: options.metadata ?? {},","    timestamp: now,","    causedBy: options.causedBy,","  };","}","","export function createEventStore(): EventStore {","  return { events: [], snapshots: {} };","}","","export function appendEvent(store: EventStore, event: DomainEvent): EventStore {","  const existing = getEventsForAggregate(store, event.aggregateId);","  if (existing.some((e) => e.version === event.version)) {","    throw new Error(`Version conflict: version ${event.version} already exists for ${event.aggregateId}`);","  }","  return { ...store, events: [...store.events, event] };","}","","export function appendEvents(store: EventStore, events: DomainEvent[]): EventStore {","  let s = store;","  for (const e of events) s = appendEvent(s, e);","  return s;","}","","export function getEventsForAggregate(store: EventStore, aggregateId: string): DomainEvent[] {","  return store.events","    .filter((e) => e.aggregateId === aggregateId)","    .sort((a, b) => a.version - b.version);","}","","export function getEventsSince(store: EventStore, aggregateId: string, version: number): DomainEvent[] {","  return getEventsForAggregate(store, aggregateId).filter((e) => e.version > version);","}","","export function getEventsByType(store: EventStore, type: EventType): DomainEvent[] {","  return store.events.filter((e) => e.type === type);","}","","export function getEventsInWindow(store: EventStore, from: number, to: number): DomainEvent[] {","  return store.events.filter((e) => e.timestamp >= from && e.timestamp <= to);","}","","export function rebuildState<S>(","  events: DomainEvent[],","  reducer: Reducer<S>,","  initialState: S","): S {","  return events.reduce((state, event) => reducer(state, event), initialState);","}","","export function rebuildFromSnapshot<S>(","  snapshot: AggregateSnapshot | undefined,","  events: DomainEvent[],","  reducer: Reducer<S>,","  initialState: S","): S {","  if (!snapshot) return rebuildState(events, reducer, initialState);","  const afterSnapshot = events.filter((e) => e.version > snapshot.version);","  const baseState = snapshot.state as S;","  return rebuildState(afterSnapshot, reducer, baseState);","}","","export function saveSnapshot(","  store: EventStore,","  aggregateId: string,","  aggregateType: string,","  state: Record<string, unknown>,","  version: number,","  now = Date.now()","): EventStore {","  const snapshot: AggregateSnapshot = { aggregateId, aggregateType, version, state, timestamp: now };","  return { ...store, snapshots: { ...store.snapshots, [aggregateId]: snapshot } };","}","","export function getSnapshot(store: EventStore, aggregateId: string): AggregateSnapshot | undefined {","  return store.snapshots[aggregateId];","}","","export function getAggregateVersion(store: EventStore, aggregateId: string): number {","  const events = getEventsForAggregate(store, aggregateId);","  if (events.length === 0) return 0;","  return events[events.length - 1].version;","}","","export function hasConflict(store: EventStore, aggregateId: string, expectedVersion: number): boolean {","  return getAggregateVersion(store, aggregateId) !== expectedVersion;","}","","export function replayEvents(","  events: DomainEvent[],","  upToVersion: number","): DomainEvent[] {","  return events.filter((e) => e.version <= upToVersion).sort((a, b) => a.version - b.version);","}","","export function groupEventsByAggregate(store: EventStore): Map<string, DomainEvent[]> {","  const map = new Map<string, DomainEvent[]>();","  for (const e of store.events) {","    const list = map.get(e.aggregateId) ?? [];","    list.push(e);","    map.set(e.aggregateId, list);","  }","  return map;","}","","export interface EventStoreStats {","  totalEvents: number;","  totalAggregates: number;","  totalSnapshots: number;","  eventsByType: Record<string, number>;","  eventsPerAggregate: Record<string, number>;","}","","export function getStoreStats(store: EventStore): EventStoreStats {","  const eventsByType: Record<string, number> = {};","  const eventsPerAggregate: Record<string, number> = {};","  for (const e of store.events) {","    eventsByType[e.type] = (eventsByType[e.type] ?? 0) + 1;","    eventsPerAggregate[e.aggregateId] = (eventsPerAggregate[e.aggregateId] ?? 0) + 1;","  }","  return {","    totalEvents: store.events.length,","    totalAggregates: Object.keys(eventsPerAggregate).length,","    totalSnapshots: Object.keys(store.snapshots).length,","    eventsByType,","    eventsPerAggregate,","  };","}"]
