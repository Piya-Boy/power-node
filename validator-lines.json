["export type FieldType = \"string\" | \"number\" | \"boolean\" | \"array\" | \"object\" | \"null\" | \"any\";","","export interface FieldSchema {","  type: FieldType | FieldType[];","  required?: boolean;","  nullable?: boolean;","  minLength?: number;","  maxLength?: number;","  pattern?: string;","  minimum?: number;","  maximum?: number;","  minItems?: number;","  maxItems?: number;","  enum?: unknown[];","  default?: unknown;","  description?: string;","  items?: FieldSchema;","  properties?: Record<string, FieldSchema>;","  additionalProperties?: boolean;","}","","export interface InputSchema {","  fields: Record<string, FieldSchema>;","  strict?: boolean;","  description?: string;","}","","export interface ValidationError {","  field: string;","  message: string;","  value?: unknown;","}","","export interface ValidationResult {","  valid: boolean;","  errors: ValidationError[];","  warnings: string[];","  sanitized: Record<string, unknown>;","}","","function typeCheck(value: unknown, type: FieldType): boolean {","  if (type === \"any\") return true;","  if (type === \"null\") return value === null;","  if (type === \"array\") return Array.isArray(value);","  if (type === \"object\") return typeof value === \"object\" && value !== null && !Array.isArray(value);","  return typeof value === type;","}","","function matchesType(value: unknown, type: FieldType | FieldType[]): boolean {","  if (Array.isArray(type)) return type.some((t) => typeCheck(value, t));","  return typeCheck(value, type);","}","","function validateField(","  fieldPath: string,","  value: unknown,","  schema: FieldSchema,","  errors: ValidationError[]","): unknown {","  const types = Array.isArray(schema.type) ? schema.type : [schema.type];","  const allowNull = schema.nullable || types.includes(\"null\");","","  // Handle null","  if (value === null || value === undefined) {","    if (allowNull || value === null && types.includes(\"null\")) return null;","    if (schema.default !== undefined) return schema.default;","    if (schema.required) {","      errors.push({ field: fieldPath, message: \"is required\", value });","    }","    return undefined;","  }","","  // Type check","  if (!matchesType(value, schema.type)) {","    // Try coercion for string->number","    if ((types.includes(\"number\") || types.includes(\"integer\")) && typeof value === \"string\") {","      const n = Number(value);","      if (!isNaN(n)) value = n;","      else { errors.push({ field: fieldPath, message: `expected ${schema.type}, got ${typeof value}`, value }); return value; }","    } else {","      errors.push({ field: fieldPath, message: `expected ${schema.type}, got ${typeof value}`, value });","      return value;","    }","  }","","  // String constraints","  if (typeof value === \"string\") {","    if (schema.minLength !== undefined && value.length < schema.minLength) {","      errors.push({ field: fieldPath, message: `minimum length is ${schema.minLength}`, value });","    }","    if (schema.maxLength !== undefined && value.length > schema.maxLength) {","      errors.push({ field: fieldPath, message: `maximum length is ${schema.maxLength}`, value });","    }","    if (schema.pattern !== undefined && !new RegExp(schema.pattern).test(value)) {","      errors.push({ field: fieldPath, message: `does not match pattern ${schema.pattern}`, value });","    }","  }","","  // Number constraints","  if (typeof value === \"number\") {","    if (schema.minimum !== undefined && value < schema.minimum) {","      errors.push({ field: fieldPath, message: `minimum value is ${schema.minimum}`, value });","    }","    if (schema.maximum !== undefined && value > schema.maximum) {","      errors.push({ field: fieldPath, message: `maximum value is ${schema.maximum}`, value });","    }","  }","","  // Enum check","  if (schema.enum !== undefined) {","    const serialized = schema.enum.map((e) => JSON.stringify(e));","    if (!serialized.includes(JSON.stringify(value))) {","      errors.push({ field: fieldPath, message: `must be one of: ${schema.enum.join(\", \")}`, value });","    }","  }","","  // Array constraints","  if (Array.isArray(value)) {","    if (schema.minItems !== undefined && value.length < schema.minItems) {","      errors.push({ field: fieldPath, message: `minimum items is ${schema.minItems}`, value });","    }","    if (schema.maxItems !== undefined && value.length > schema.maxItems) {","      errors.push({ field: fieldPath, message: `maximum items is ${schema.maxItems}`, value });","    }","    if (schema.items) {","      value = value.map((item, idx) => validateField(`${fieldPath}[${idx}]`, item, schema.items!, errors));","    }","  }","","  // Object constraints","  if (typeof value === \"object\" && value !== null && !Array.isArray(value)) {","    const obj = value as Record<string, unknown>;","    if (schema.properties) {","      const sanitized: Record<string, unknown> = {};","      for (const [key, propSchema] of Object.entries(schema.properties)) {","        sanitized[key] = validateField(`${fieldPath}.${key}`, obj[key], propSchema, errors);","      }","      if (schema.additionalProperties === false) {","        for (const key of Object.keys(obj)) {","          if (!(key in schema.properties)) {","            errors.push({ field: `${fieldPath}.${key}`, message: \"additional property not allowed\", value: obj[key] });","          }","        }","      }","      return sanitized;","    }","  }","","  return value;","}","","export function validateInput(","  input: Record<string, unknown>,","  schema: InputSchema","): ValidationResult {","  const errors: ValidationError[] = [];","  const warnings: string[] = [];","  const sanitized: Record<string, unknown> = {};","","  // Validate known fields","  for (const [field, fieldSchema] of Object.entries(schema.fields)) {","    const value = input[field] ?? fieldSchema.default;","    const result = validateField(field, value, fieldSchema, errors);","    if (result !== undefined) sanitized[field] = result;","  }","","  // Check for unknown fields in strict mode","  if (schema.strict) {","    for (const key of Object.keys(input)) {","      if (!(key in schema.fields)) {","        warnings.push(`Unknown field: ${key}`);","      }","    }","  }","","  return { valid: errors.length === 0, errors, warnings, sanitized };","}","","export function validateField_exported(","  fieldPath: string,","  value: unknown,","  schema: FieldSchema","): { errors: ValidationError[]; sanitized: unknown } {","  const errors: ValidationError[] = [];","  const sanitized = validateField(fieldPath, value, schema, errors);","  return { errors, sanitized };","}","","export function mergeDefaults(","  input: Record<string, unknown>,","  schema: InputSchema","): Record<string, unknown> {","  const result = { ...input };","  for (const [field, fieldSchema] of Object.entries(schema.fields)) {","    if (result[field] === undefined && fieldSchema.default !== undefined) {","      result[field] = fieldSchema.default;","    }","  }","  return result;","}","","export function getRequiredFields(schema: InputSchema): string[] {","  return Object.entries(schema.fields)","    .filter(([, s]) => s.required)","    .map(([k]) => k);","}","","export function hasAllRequired(input: Record<string, unknown>, schema: InputSchema): boolean {","  return getRequiredFields(schema).every((field) => input[field] !== undefined && input[field] !== null);","}"]
