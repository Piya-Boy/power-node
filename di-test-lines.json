["import { describe, it, expect } from \"vitest\";","import {","  createContainer,","  register,","  registerValue,","  registerAlias,","  hasService,","  resolve,","  resolveAll,","  createScope,","  disposeScope,","  listRegistered,","  getDescriptor,","  getServicesByTag,","  getContainerStats,","} from \"./di-container\";","","// ─────────────────────────────────────────────────────────────────────────────","// createContainer / register / hasService","// ─────────────────────────────────────────────────────────────────────────────","","describe(\"createContainer\", () => {","  it(\"creates empty container\", () => {","    const c = createContainer();","    expect(c.descriptors.size).toBe(0);","    expect(c.singletons.size).toBe(0);","  });","});","","describe(\"register / hasService\", () => {","  it(\"registers service\", () => {","    const c = register(createContainer(), \"logger\", () => ({ log: () => {} }));","    expect(hasService(c, \"logger\")).toBe(true);","    expect(hasService(c, \"missing\")).toBe(false);","  });","","  it(\"is immutable\", () => {","    const original = createContainer();","    register(original, \"a\", () => 1);","    expect(hasService(original, \"a\")).toBe(false);","  });","","  it(\"defaults to transient lifetime\", () => {","    const c = register(createContainer(), \"svc\", () => ({}));","    expect(getDescriptor(c, \"svc\")?.lifetime).toBe(\"transient\");","  });","});","","// ─────────────────────────────────────────────────────────────────────────────","// registerValue","// ─────────────────────────────────────────────────────────────────────────────","","describe(\"registerValue\", () => {","  it(\"registers a constant value as singleton\", () => {","    const c = registerValue(createContainer(), \"config\", { host: \"localhost\" });","    expect(resolve<{ host: string }>(c, \"config\").host).toBe(\"localhost\");","    expect(getDescriptor(c, \"config\")?.lifetime).toBe(\"singleton\");","  });","});","","// ─────────────────────────────────────────────────────────────────────────────","// resolve — transient / singleton / scoped","// ─────────────────────────────────────────────────────────────────────────────","","describe(\"resolve\", () => {","  it(\"resolves transient service (new instance each time)\", () => {","    let c = createContainer();","    let counter = 0;","    c = register(c, \"counter\", () => ++counter, { lifetime: \"transient\" });","    expect(resolve<number>(c, \"counter\")).toBe(1);","    expect(resolve<number>(c, \"counter\")).toBe(2);","  });","","  it(\"resolves singleton (same instance)\", () => {","    let c = createContainer();","    let counter = 0;","    c = register(c, \"singleton\", () => ++counter, { lifetime: \"singleton\" });","    expect(resolve<number>(c, \"singleton\")).toBe(1);","    expect(resolve<number>(c, \"singleton\")).toBe(1);","  });","","  it(\"resolves scoped (same within scope)\", () => {","    let c = createContainer();","    let counter = 0;","    c = register(c, \"scoped\", () => ++counter, { lifetime: \"scoped\" });","    const scope = createScope(c, \"req-1\");","    expect(resolve<number>(scope, \"scoped\")).toBe(1);","    expect(resolve<number>(scope, \"scoped\")).toBe(1); // same scope","    const scope2 = createScope(c, \"req-2\");","    expect(resolve<number>(scope2, \"scoped\")).toBe(2); // new scope","  });","","  it(\"throws when service not found\", () => {","    expect(() => resolve(createContainer(), \"missing\")).toThrow(\"Service not registered: missing\");","  });","","  it(\"injects dependencies via container\", () => {","    let c = createContainer();","    c = registerValue(c, \"host\", \"example.com\");","    c = register(c, \"url\", (container) => \"http://\" + resolve<string>(container, \"host\"), { lifetime: \"transient\" });","    expect(resolve<string>(c, \"url\")).toBe(\"http://example.com\");","  });","});","","// ─────────────────────────────────────────────────────────────────────────────","// registerAlias","// ─────────────────────────────────────────────────────────────────────────────","","describe(\"registerAlias\", () => {","  it(\"resolves alias to target\", () => {","    let c = createContainer();","    c = registerValue(c, \"db\", { query: \"yes\" });","    c = registerAlias(c, \"database\", \"db\");","    expect(resolve<{ query: string }>(c, \"database\").query).toBe(\"yes\");","  });","});","","// ─────────────────────────────────────────────────────────────────────────────","// resolveAll","// ─────────────────────────────────────────────────────────────────────────────","","describe(\"resolveAll\", () => {","  it(\"resolves all services with matching tag\", () => {","    let c = createContainer();","    c = register(c, \"plugin-a\", () => ({ name: \"a\" }), { lifetime: \"transient\", tags: [\"plugin\"] });","    c = register(c, \"plugin-b\", () => ({ name: \"b\" }), { lifetime: \"transient\", tags: [\"plugin\"] });","    c = register(c, \"other\", () => ({ name: \"c\" }), { lifetime: \"transient\", tags: [\"other\"] });","    const plugins = resolveAll<{ name: string }>(c, \"plugin\");","    expect(plugins).toHaveLength(2);","    expect(plugins.map((p) => p.name).sort()).toEqual([\"a\", \"b\"]);","  });","","  it(\"returns empty when no tag matches\", () => {","    expect(resolveAll(createContainer(), \"unknown\")).toHaveLength(0);","  });","});","","// ─────────────────────────────────────────────────────────────────────────────","// createScope / disposeScope","// ─────────────────────────────────────────────────────────────────────────────","","describe(\"createScope\", () => {","  it(\"inherits parent descriptors\", () => {","    let parent = createContainer();","    parent = registerValue(parent, \"shared\", \"value\");","    const scope = createScope(parent, \"s1\");","    expect(resolve<string>(scope, \"shared\")).toBe(\"value\");","  });","","  it(\"scope has its own scopedInstances\", () => {","    let parent = createContainer();","    let counter = 0;","    parent = register(parent, \"scoped\", () => ++counter, { lifetime: \"scoped\" });","    const s1 = createScope(parent, \"s1\");","    const s2 = createScope(parent, \"s2\");","    expect(resolve<number>(s1, \"scoped\")).toBe(1);","    expect(resolve<number>(s2, \"scoped\")).toBe(2);","  });","});","","describe(\"disposeScope\", () => {","  it(\"clears scoped instances\", () => {","    let parent = createContainer();","    let counter = 0;","    parent = register(parent, \"svc\", () => ++counter, { lifetime: \"scoped\" });","    let scope = createScope(parent, \"s1\");","    resolve<number>(scope, \"svc\"); // creates instance","    expect(scope.scopedInstances.size).toBe(1);","    scope = disposeScope(scope);","    expect(scope.scopedInstances.size).toBe(0);","  });","});","","// ─────────────────────────────────────────────────────────────────────────────","// listRegistered / getDescriptor / getServicesByTag / getContainerStats","// ─────────────────────────────────────────────────────────────────────────────","","describe(\"listRegistered\", () => {","  it(\"returns all registered tokens\", () => {","    let c = createContainer();","    c = registerValue(c, \"a\", 1);","    c = registerValue(c, \"b\", 2);","    expect(listRegistered(c).sort()).toEqual([\"a\", \"b\"]);","  });","});","","describe(\"getDescriptor\", () => {","  it(\"returns descriptor for token\", () => {","    const c = register(createContainer(), \"svc\", () => ({}), { tags: [\"api\"] });","    expect(getDescriptor(c, \"svc\")?.tags).toContain(\"api\");","  });","});","","describe(\"getServicesByTag\", () => {","  it(\"returns descriptors with tag\", () => {","    let c = createContainer();","    c = register(c, \"a\", () => ({}), { tags: [\"handler\"] });","    c = register(c, \"b\", () => ({}), { tags: [\"handler\", \"auth\"] });","    c = register(c, \"c\", () => ({}), { tags: [\"other\"] });","    expect(getServicesByTag(c, \"handler\")).toHaveLength(2);","  });","});","","describe(\"getContainerStats\", () => {","  it(\"computes stats\", () => {","    let c = createContainer();","    c = register(c, \"a\", () => ({}), { lifetime: \"singleton\", tags: [\"core\"] });","    c = register(c, \"b\", () => ({}), { lifetime: \"transient\" });","    c = register(c, \"d\", () => ({}), { lifetime: \"scoped\" });","    const stats = getContainerStats(c);","    expect(stats.registeredCount).toBe(3);","    expect(stats.byLifetime.singleton).toBe(1);","    expect(stats.byLifetime.transient).toBe(1);","    expect(stats.byLifetime.scoped).toBe(1);","    expect(stats.tags).toContain(\"core\");","  });","});"]
